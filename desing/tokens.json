{
  "name": "SismoMex Monitor Design System",
  "version": "1.0.0",
  "description": "Tokens de diseño, paleta de colores y parámetros de animación para el monitor sísmico en tiempo real (sin dependencias de backend)",
  "colors": {
    "background": {
      "app": "#080f19",
      "sidebar": "#08111c",
      "surface": "#121e2f",
      "surfaceElevated": "#1e3555",
      "headerBar": "#273a56",
      "card": "#0f1d30"
    },
    "borders": {
      "subtle": "#142236",
      "default": "#1c2e46",
      "highlight": "#2a4365"
    },
    "text": {
      "primary": "#f1f5f9",
      "secondary": "#94a3b8",
      "muted": "#64748b",
      "accent": "#38bdf8"
    },
    "alerts": {
      "critical": "#dc2626",
      "criticalPulse": "#ef4444",
      "warning": "#f59e0b",
      "caution": "#ffc800",
      "info": "#0284c7",
      "normal": "#10b981"
    },
    "mercalliScale": {
      "0": "#001ee0",
      "1": "#007aff",
      "2": "#00d4ba",
      "3": "#059669",
      "4": "#f97316",
      "5": "#ffd200",
      "6": "#ea580c",
      "7": "#ff2626",
      "8": "#be0f0f",
      "9": "#880e4f",
      "10": "#a855f7"
    },
    "waves": {
      "pWave": {
        "stroke": "#38bdf8",
        "fill": "rgba(56, 189, 248, 0.12)",
        "speedKmPerSec": 6.2
      },
      "sWave": {
        "stroke": "#ef4444",
        "fill": "rgba(239, 68, 68, 0.18)",
        "speedKmPerSec": 3.55
      }
    }
  },
  "animations": {
    "radarPing": {
      "duration": "1.8s",
      "timing": "cubic-bezier(0, 0.2, 0.8, 1)"
    },
    "alertPulse": {
      "duration": "1.2s",
      "timing": "ease-in-out"
    },
    "stationBreathe": {
      "duration": "2.4s",
      "timing": "ease-in-out"
    },
    "sheetSlide": {
      "duration": "0.3s",
      "timing": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  }
}
